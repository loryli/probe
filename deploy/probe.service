[Unit]
Description=练习场 FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=probe
Group=probe
WorkingDirectory=/opt/probe
Environment=INTERVIEW_ENVIRONMENT=production
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/opt/probe/data
Environment=XDG_CACHE_HOME=/opt/probe/.cache
Environment=OMP_NUM_THREADS=1
ExecStartPre=/usr/bin/test -f /opt/probe/.env
ExecStartPre=/usr/bin/test -f /opt/probe/frontend/dist/index.html
ExecStart=/opt/probe/.venv/bin/python -m uvicorn interview_assistant.main:create_app --factory --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/probe/data /opt/probe/.cache

[Install]
WantedBy=multi-user.target
