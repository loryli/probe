INTERVIEW_ENVIRONMENT=local
INTERVIEW_LOG_LEVEL=INFO

# local 环境留空时使用 data/interview.sqlite3，首次启动自动准备表结构。
# 自定义数据目录可设置 INTERVIEW_DATA_DIR，默认 data；不需要 MySQL 账号。
# 仅在主动选择 MySQL 时填写连接串，并先创建数据库、手动执行 Alembic 迁移。
# MySQL 用户名和密码中的特殊字符需要 URL 编码。
# INTERVIEW_DATABASE_URL=mysql+aiomysql://interview:password@127.0.0.1:3306/interview?charset=utf8mb4
INTERVIEW_DATABASE_URL=
INTERVIEW_DATA_DIR=data
INTERVIEW_DATABASE_PROBE_TIMEOUT_SECONDS=3

# PDF OCR 首次使用时下载模型，默认缓存到 data/ocr-models。
# 如需更换目录，填写可写路径；简历识别在本机执行，不上传简历。
# INTERVIEW_OCR_MODEL_DIR=data/ocr-models

# 留给后续 Qwen 适配器使用，当前题库功能不调用模型。
# INTERVIEW_QWEN_API_KEY=
# INTERVIEW_QWEN_MODEL=

